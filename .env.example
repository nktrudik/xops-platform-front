XOPS_PORT=8080
MTS_FONTS_DIR=./mts_shrift/ШРИФТ/Web
# Для Compose используйте существующий kubeconfig и ingress-хост кластера.
# KUBECONFIG_FILE=/absolute/path/to/kubeconfig
XOPS_COPILOT_HOST=
XOPS_PLATFORM_NAMESPACE=platform-xops-dev
# Секреты задаются только в локальном .env; файл не коммитится.
POSTGRES_PASSWORD=
# Сгенерировать: cd backend && poetry run python -m app.auth
# В .env заключите scrypt-хеш в одинарные кавычки, чтобы сохранить символы $.
XOPS_ADMIN_PASSWORD_HASH=''
# Для HTTPS установите true; текущий DEV использует HTTP.
XOPS_COOKIE_SECURE=false
